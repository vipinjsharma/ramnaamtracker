# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard) to enable cross-device
# sync. Both are safe to expose to the browser - only the anon/public key
# belongs here, never the service_role key.
#
# Without these set, the app runs entirely on localStorage, exactly as
# before - no sign-in UI is shown and nothing breaks.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
